[OrbitronFont:asset font]
  path:string "assets/fonts/"
  filename: string "Orbitron.ttf"

[TestSprite:asset zxl]
  path:string "assets/sprites/"
  filename:string "test_2x2.zxl"

[RenderTestScene:scene]
  // Background grid helper
  [Background:entity]
    [Transform]
      position:vec3 {0.0, 0.0, -1.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 100.0
      half_height:f32 100.0
      fill_color:color #0a0a0a
      visible:bool true
    [Tag]
      tags:string "background"

  // World origin marker (center reference)
  [OriginMarker:entity]
    [Transform]
      position:vec3 {0.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #ff00ff
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "origin"

  // ZXL sprite test — should appear as a small pixel art quad near the origin
  [ZxlTest:entity]
    [Transform]
      position:vec2 {3.0, 3.0}
      scale:f32 1.0
    [ZxlSprite]
      asset_name:string "TestSprite"
      pixel_scale:f32 2.0
      tint:color #ffffff

  // Timed-death sprite — appears lower-left, LifetimeSys destroys it after 2s
  [DyingSprite:entity]
    [Transform]
      position:vec2 {-20.0, -15.0}
      scale:f32 1.0
    [ZxlSprite]
      asset_name:string "TestSprite"
      pixel_scale:f32 3.0
    [Lifetime]
      remaining:f32 2.0

  // Ellipse opposite ZxlTest (upper-right sprite → mirrored to the left)
  [EllipseBoth:entity]
    [Transform]
      position:vec3 {-3.0, 3.0, 0.0}
      scale:f32 1.0
    [Sprite:ellipse]
      origin:vec2 {0.0, 0.0}
      semi_major:f32 1.6
      semi_minor:f32 0.9
      fill_color:color #FF00AA
      stroke_color:color #FFFFFF
      stroke_width:f32 1.5
      visible:bool true

  // Timed-death ellipse — mirrors DyingSprite to the opposite (upper-right) corner
  [EllipseTimed:entity]
    [Transform]
      position:vec3 {20.0, 15.0, 0.0}
      scale:f32 1.0
    [Sprite:ellipse]
      origin:vec2 {0.0, 0.0}
      semi_major:f32 1.4
      semi_minor:f32 1.0
      fill_color:color #00CCFF
      stroke_color:color #FFFF00
      stroke_width:f32 2.0
      visible:bool true
    [Lifetime]
      remaining:f32 3.0

  // Player - camera will follow this
  [Player:entity]
    [Transform]
      position:vec3 {0.0, 0.0, 0.5}
      scale:f32 1.0
    [Velocity]
      linear:vec2 {0.0, 0.0}
      angular:f32 0.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.5
      fill_color:color #00ff00
      stroke_color:color #00aa00
      stroke_width:f32 3.0
      visible:bool true
      opacity:f32 0.5
    [Collider:circle]
      radius:f32 1.5
    [Tag]
      tags:string "player"
    [OnInput]
      [trigger]
        key:string "W"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {0.0, 10.0}
          priority:i32 0
      [trigger]
        key:string "S"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {0.0, -10.0}
          priority:i32 0
      [trigger]
        key:string "A"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {-10.0, 0.0}
          priority:i32 0
      [trigger]
        key:string "D"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {10.0, 0.0}
          priority:i32 0
      // Space → fire a SpaceBullet (small circle, moves up, dies after 2s).
      // NOTE: input triggers have no collision_loc, so spawn is at `offset`
      // (world origin + offset), not at the player's position.
      [trigger]
        key:string "Space"
        phase:string "pressed"
        [action]
          type:string "spawn_entity"
          template_name:string "SpaceBullet"
          offset:vec2 {0.0, 0.0}
          priority:i32 0

  // Reference markers at known world positions
  // North marker (+Y)
  [NorthMarker:entity]
    [Transform]
      position:vec3 {0.0, 20.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 2.0
      half_height:f32 1.0
      fill_color:color #ff0000
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 2.0
      half_height:f32 1.0
    [Tag]
      tags:string "marker north"

  // South marker (-Y)
  [SouthMarker:entity]
    [Transform]
      position:vec3 {0.0, -20.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 2.0
      half_height:f32 1.0
      fill_color:color #ff0000
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "marker south"

  // East marker (+X)
  [EastMarker:entity]
    [Transform]
      position:vec3 {30.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 1.0
      half_height:f32 2.0
      fill_color:color #0000ff
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 1.0
      half_height:f32 2.0
    [Tag]
      tags:string "marker east"

  // West marker (-X)
  [WestMarker:entity]
    [Transform]
      position:vec3 {-30.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 1.0
      half_height:f32 2.0
      fill_color:color #0000ff
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "marker west"

  // Corner markers to test bounds
  [CornerNE:entity]
    [Transform]
      position:vec3 {30.0, 20.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.0
      fill_color:color #ffff00
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "corner"

  [CornerNW:entity]
    [Transform]
      position:vec3 {-30.0, 20.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.0
      fill_color:color #ffff00
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "corner"

  [CornerSE:entity]
    [Transform]
      position:vec3 {30.0, -20.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.0
      fill_color:color #ffff00
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "corner"

  [CornerSW:entity]
    [Transform]
      position:vec3 {-30.0, -20.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.0
      fill_color:color #ffff00
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "corner"

  // Grid of entities to show culling
  [GridDot1:entity]
    [Transform]
      position:vec3 {-15.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  [GridDot2:entity]
    [Transform]
      position:vec3 {-10.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  [GridDot3:entity]
    [Transform]
      position:vec3 {-5.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  [GridDot4:entity]
    [Transform]
      position:vec3 {5.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  [GridDot5:entity]
    [Transform]
      position:vec3 {10.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  [GridDot6:entity]
    [Transform]
      position:vec3 {15.0, 10.0, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.5
      fill_color:color #888888
      visible:bool true
    [Tag]
      tags:string "grid"

  // ============================================
  // NEW SHAPE SHOWCASE  (lower band, x:-28..28  y:-10..-17)
  // ============================================
  // New shapes + stroke-width + opacity paths. Row roughly left→right.

  // --- RoundedRect: uniform radius, filled + stroked ---
  [ShowRoundRect:entity]
    [Transform]
      position:vec3 {-26.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:roundedrect]
      center:vec2 {0.0, 0.0}
      half_width:f32 3.0
      half_height:f32 2.0
      radius:f32 1.0
      fill_color:color #4488ff
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "showcase roundrect"

//  // --- RoundedRect: per-corner radii (asymmetric), fill only ---
//  [ShowRoundRectAsym:entity]
//    [Transform]
//      position:vec3 {-19.0, -12.0, 0.0}
//      scale:f32 1.0
//    [Sprite:roundedrect]
//      center:vec2 {0.0, 0.0}
//      half_width:f32 2.5
//      half_height:f32 2.5
//      radius_tl:f32 2.0
//      radius_tr:f32 0.0
//      radius_br:f32 2.0
//      radius_bl:f32 0.0
//      fill_color:color #ff8844
//      visible:bool true
//    [Tag]
//      tags:string "showcase roundrect-asym"

  // --- Capsule: horizontal pill (paddle), stroked, half-opacity ---
  [ShowCapsuleH:entity]
    [Transform]
      position:vec3 {-12.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:capsule]
      center:vec2 {0.0, 0.0}
      half_width:f32 3.5
      half_height:f32 1.2
      fill_color:color #22cc88
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
      opacity:f32 0.5
    [Tag]
      tags:string "showcase capsule-h"

  // --- Capsule: vertical pill (implied radius on the short axis) ---
  [ShowCapsuleV:entity]
    [Transform]
      position:vec3 {-6.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:capsule]
      center:vec2 {0.0, 0.0}
      half_width:f32 1.2
      half_height:f32 3.0
      fill_color:color #cc4488
      visible:bool true
    [Tag]
      tags:string "showcase capsule-v"

  // --- Arc: filled pie/wedge (thickness 0) ---
  [ShowArcPie:entity]
    [Transform]
      position:vec3 {0.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:arc]
      origin:vec2 {0.0, 0.0}
      radius:f32 2.5
      thickness:f32 0.0 // put back to 0
      start_angle:f32 0.0
      end_angle:f32 2.2
      fill_color:color #ffcc00
      stroke_color:color #ffffff
      stroke_width:f32 1.5
      visible:bool true
    [Tag]
      tags:string "showcase arc-pie"

  // --- Arc: ring segment / donut slice (thickness > 0), e.g. health ring ---
  [ShowArcRing:entity]
    [Transform]
      position:vec3 {6.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:arc]
      origin:vec2 {0.0, 0.0}
      radius:f32 2.8
      thickness:f32 0.8
      start_angle:f32 0.5
      end_angle:f32 5.0
      fill_color:color #00ddff
      visible:bool true
    [Tag]
      tags:string "showcase arc-ring"

  // --- NGon: hexagon (sides:u32 int-field path), stroked ---
  [ShowHexagon:entity]
    [Transform]
      position:vec3 {13.0, -12.0, 0.0}
      scale:f32 1.0
    [Sprite:ngon]
      origin:vec2 {0.0, 0.0}
      radius:f32 2.5
      sides:u32 6
      fill_color:color #8866ff
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "showcase ngon-hex"

  // --- NGon: triangle (min sides = 3), oriented via Transform.rotation, thick stroke ---
  [ShowTriGon:entity]
    [Transform]
      position:vec3 {19.0, -12.0, 0.0}
      rotation:f32 1.57
      scale:f32 1.0
    [Sprite:ngon]
      origin:vec2 {0.0, 0.0}
      radius:f32 2.5
      sides:u32 3
      fill_color:color #ff5566
      stroke_color:color #ffff00
      stroke_width:f32 4.0
      visible:bool true
    [Tag]
      tags:string "showcase ngon-tri"

  // --- Star: 5-point, filled + stroked (point-up via Transform.rotation) ---
  [ShowStar:entity]
    [Transform]
      position:vec3 {25.0, -12.0, 0.0}
      rotation:f32 1.57
      scale:f32 1.0
    [Sprite:star]
      origin:vec2 {0.0, 0.0}
      outer_radius:f32 2.8
      inner_radius:f32 1.2
      points:u32 5
      fill_color:color #ffdd00
      stroke_color:color #ffffff
      stroke_width:f32 1.5
      visible:bool true
    [Tag]
      tags:string "showcase star"

  // --- Star: 8-point spiky (small inner radius), half-opacity ---
  [ShowStarSpiky:entity]
    [Transform]
      position:vec3 {-23.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:star]
      origin:vec2 {0.0, 0.0}
      outer_radius:f32 2.5
      inner_radius:f32 0.7
      points:u32 8
      fill_color:color #ff66cc
      visible:bool true
      opacity:f32 0.5
    [Tag]
      tags:string "showcase star-spiky"

  // --- Polyline: open path, acts like line (stroke_width + stroke_color) ---
  [ShowPolyline:entity]
    [Transform]
      position:vec3 {-14.0, -16.5, 0.0}
      scale:f32 1.25
    [Sprite:polyline]
      points:vec2[] {{-6.0, 0.0}, {-3.0, 2.0}, {0.0, -1.0}, {3.0, 2.0}, {6.0, 0.0}}
      stroke_color:color #00ffaa
      stroke_width:f32 3.0
      visible:bool true
    [Tag]
      tags:string "showcase polyline"

  // --- Polyline: thin zigzag, different color, tests width path ---
  [ShowPolylineThin:entity]
    [Transform]
      position:vec3 {2.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:polyline]
      points:vec2[] {{-5.0, -1.0}, {-2.5, 1.5}, {0.0, -1.0}, {2.5, 1.5}, {5.0, -1.0}}
      stroke_color:color #ff8800
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "showcase polyline-thin"

  // --- Stroke-width ladder: same circle, increasing stroke_width ---
  [StrokeLadder1:entity]
    [Transform]
      position:vec3 {14.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.2
      fill_color:color #222222
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "showcase stroke-ladder"

  [StrokeLadder2:entity]
    [Transform]
      position:vec3 {18.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.2
      fill_color:color #222222
      stroke_color:color #ffffff
      stroke_width:f32 3.0
      visible:bool true
    [Tag]
      tags:string "showcase stroke-ladder"

  [StrokeLadder3:entity]
    [Transform]
      position:vec3 {22.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.2
      fill_color:color #222222
      stroke_color:color #ffffff
      stroke_width:f32 6.0
      visible:bool true
    [Tag]
      tags:string "showcase stroke-ladder"

  // --- Opacity ladder: same yellow star, decreasing opacity over dark bg ---
  [OpacityLadder1:entity]
    [Transform]
      position:vec3 {26.0, -16.5, 0.0}
      scale:f32 1.0
    [Sprite:ngon]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.3
      sides:u32 5
      fill_color:color #ffff00
      visible:bool true
      opacity:f32 1.0
    [Tag]
      tags:string "showcase opacity-ladder"

  [OpacityLadder2:entity]
    [Transform]
      position:vec3 {28.0, -14.0, 0.0}
      scale:f32 1.0
    [Sprite:ngon]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.3
      sides:u32 5
      fill_color:color #ffff00
      visible:bool true
      opacity:f32 0.6
    [Tag]
      tags:string "showcase opacity-ladder"

  [OpacityLadder3:entity]
    [Transform]
      position:vec3 {28.0, -11.5, 0.0}
      scale:f32 1.0
    [Sprite:ngon]
      origin:vec2 {0.0, 0.0}
      radius:f32 1.3
      sides:u32 5
      fill_color:color #ffff00
      visible:bool true
      opacity:f32 0.25
    [Tag]
      tags:string "showcase opacity-ladder"

  // Showcase label (world-space text under the row)
  [ShowcaseLabel:entity]
    [Transform]
      position:vec2 {-27.0, -18.5}
    [Text]
      text:string "phase 3.1 shapes: roundrect capsule arc ngon star polyline | stroke+opacity ladders"
      font_name:string "OrbitronFont"
      text_color:color #cccccc
      size:f32 0.4

  // ============================================
  // SCREEN-SPACE UI ELEMENTS (HUD)
  // ============================================
  // These should stay fixed on screen while camera moves

  // Health Bar Background
  [HealthBarBG:entity]
    [UIElement]
      anchor:string "TopLeft"
      offset:vec2 {150.0, 50.0}
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 100.0
      half_height:f32 10.0
      fill_color:color #330000
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "ui hud healthbar"

  // Health Bar Fill
  [HealthBarFill:entity]
    [UIElement]
      anchor:string "TopLeft"
      offset:vec2 {150.0, 50.0}
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 90.0
      half_height:f32 8.0
      fill_color:color #00ff00
      visible:bool true
    [Tag]
      tags:string "ui hud healthbar-fill"

  // Score Display Background
  [ScoreBG:entity]
    [UIElement]
      anchor:string "TopRight"
      offset:vec2 {-80.0, 50.0}
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 80.0
      half_height:f32 15.0
      fill_color:color #000033
      stroke_color:color #ffffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "ui hud score"

  // Crosshair
  [Crosshair:entity]
    [UIElement]
      anchor:string "MiddleCenter"
      offset:vec2 {0.0, 0.0}
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 10.0
      fill_color:color #ff0000
      stroke_color:color #ffffff
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "ui crosshair"

  // Mini-map background
  [MinimapBG:entity]
    [UIElement]
      anchor:string "BottomRight"
      offset:vec2 {-100.0, -100.0}
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 60.0
      half_height:f32 60.0
      fill_color:color #001a1a
      stroke_color:color #00ffff
      stroke_width:f32 2.0
      visible:bool true
    [Tag]
      tags:string "ui minimap"

  // Mini-map player indicator (should be centered in minimap)
  [MinimapPlayer:entity]
    [UIElement]
      anchor:string "BottomRight"
      offset:vec2 {-100.0, -100.0}
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 4.0
      fill_color:color #00ff00
      visible:bool true
    [Tag]
      tags:string "ui minimap-player"

  // Bottom UI panel
  [BottomPanel:entity]
    [UIElement]
      anchor:string "BottomLeft"
      offset:vec2 {400.0, -30.0}
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 380.0
      half_height:f32 25.0
      fill_color:color #1a1a1a
      stroke_color:color #666666
      stroke_width:f32 1.0
      visible:bool true
    [Tag]
      tags:string "ui panel"

  // Title and instructions (world-space text)
  [TitleText:entity]
    [Transform]
      position:vec2 {-13.0, 9.0}
    [Text]
      text:string "ui test scene - screen-space hud elements"
      font_name:string "OrbitronFont"
      text_color:color #ffffff
      size:f32 0.7

  [Instructions1:entity]
    [Transform]
      position:vec2 {-13.0, -8.5}
    [Text]
      text:string "arrow keys: pan camera | q/e: zoom in/out | r: reset camera"
      font_name:string "OrbitronFont"
