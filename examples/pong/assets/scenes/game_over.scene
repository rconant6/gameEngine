[GameOverScene:scene]

  // Centered via alignment:"center" (F5) — at x=0 the renderer offsets by
  // -measureText/2, so no hand-tuned -x nudges.
  [GameOverText:entity]
    [Transform]
      position:vec3 {0.0, 2.0, 0.0}
      scale:f32 1.0
    [Text]
      text:string "GAME OVER"
      size:f32 2.0
      text_color:color #FF4444
      alignment:string "center"
    [Tag]
      tags:string "game_over_banner"

  [PressSpaceText:entity]
    [Transform]
      position:vec3 {0.0, -1.5, 0.0}
      scale:f32 1.0
    [Text]
      text:string "PRESS SPACE"
      size:f32 1.0
      text_color:color #FFFFFF
      alignment:string "center"
    [Tag]
      tags:string "press_space_banner"

  [CenterLine:entity]
    [Transform]
      position:vec3 {0.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.05
      half_height:f32 10.0
      fill_color:color #333333
      visible:bool true
