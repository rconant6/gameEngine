[GameOverScene:scene]

  // Real text replaces the old gray placeholder rectangles. World-space [Text]
  // renders from its Transform position (left-to-right), so x is nudged negative
  // to roughly center each line — tune against the running window.
  [GameOverText:entity]
    [Transform]
      position:vec3 {-5.0, 2.0, 0.0}
      scale:f32 1.0
    [Text]
      text:string "GAME OVER"
      size:f32 2.0
      text_color:color #FF4444
    [Tag]
      tags:string "game_over_banner"

  [PressSpaceText:entity]
    [Transform]
      position:vec3 {-4.5, -1.5, 0.0}
      scale:f32 1.0
    [Text]
      text:string "PRESS SPACE"
      size:f32 1.0
      text_color:color #FFFFFF
    [Tag]
      tags:string "press_space_banner"

  [CenterLine:entity]
    [Transform]
      position:vec3 {0.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.05
      half_height:f32 10.0
      fill_color:color #333333
      visible:bool true
