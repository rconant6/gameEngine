[GameOverScene:scene]

  [GameOverText:entity]
    [Transform]
      position:vec3 {0.0, 2.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 6.0
      half_height:f32 1.2
      fill_color:color #222222
      visible:bool true
    [Tag]
      tags:string "game_over_banner"

  [PressSpaceText:entity]
    [Transform]
      position:vec3 {0.0, -1.5, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 4.0
      half_height:f32 0.7
      fill_color:color #222222
      visible:bool true
    [Tag]
      tags:string "press_space_banner"

  [CenterLine:entity]
    [Transform]
      position:vec3 {0.0, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.05
      half_height:f32 10.0
      fill_color:color #333333
      visible:bool true
