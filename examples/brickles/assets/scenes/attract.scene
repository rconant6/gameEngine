// Attract / title screen. Pure presentation — main.zig watches for Space to
// start the game. Text is centered via alignment:"center" (F5) — placed at x=0,
// the renderer offsets by -measureText/2, so no hand-tuned -x nudges.
[AttractScene:scene]

  [Title:entity]
    [Transform]
      position:vec3 {0.0, 3.0, 0.0}
    [Text]
      text:string "BRICKLES"
      size:f32 3.0
      text_color:color #4FC3F7
      alignment:string "center"

  [Prompt:entity]
    [Transform]
      position:vec3 {0.0, -2.0, 0.0}
    [Text]
      text:string "PRESS SPACE TO PLAY"
      size:f32 1.2
      text_color:color #FFFFFF
      alignment:string "center"

  [Hint:entity]
    [Transform]
      position:vec3 {0.0, -4.5, 0.0}
    [Text]
      text:string "ARROW KEYS MOVE PADDLE"
      size:f32 0.8
      text_color:color #888888
      alignment:string "center"
