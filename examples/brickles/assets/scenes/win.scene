// Win screen. The final SCORE is still live in the "score" state var, so a
// StateText shows it without any main.zig plumbing.
[WinScene:scene]

  [Banner:entity]
    [Transform]
      position:vec3 {-5.5, 3.0, 0.0}
    [Text]
      text:string "YOU WIN!"
      size:f32 3.0
      text_color:color #FFD54F

  [FinalScore:entity]
    [Transform]
      position:vec3 {-4.0, -0.5, 0.0}
    [Text]
      text:string "SCORE 0"
      size:f32 1.4
      text_color:color #FFFFFF
    [StateText]
      key:string "score"
      prefix:string "SCORE "

  [Prompt:entity]
    [Transform]
      position:vec3 {-7.5, -4.0, 0.0}
    [Text]
      text:string "PRESS SPACE TO PLAY AGAIN"
      size:f32 1.0
      text_color:color #FFFFFF
