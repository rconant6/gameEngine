// Brickles — the playfield. World is ~35.5 wide x 20 tall (ortho 10, 16:9):
// x in [-17.7, 17.7], y in [-10, 10]. Bricks up top, paddle at the bottom,
// gutter just below the paddle. All gameplay logic lives in scene actions:
//   - ball: OnCollision bounce off wall/paddle/brick
//   - paddle: OnInput held -> set_velocity, released -> stop
//   - brick: (in bricks.template) destroy_self + score + bricks-- on ball hit
//   - gutter: OnCollision ball -> balls-- + transition_state serve
// main.zig only does serve/launch and win/lose detection on the state vars.

[BricklesScene:scene]

  // ── Ball ──
  [Ball:entity]
    [Transform]
      position:vec3 {0.0, -6.0, 0.0}
      scale:f32 1.0
    [Velocity]
      linear:vec2 {0.0, 0.0}
      angular:f32 0.0
    [Sprite:circle]
      origin:vec2 {0.0, 0.0}
      radius:f32 0.35
      fill_color:color #FFFFFF
      stroke_color:color #BBBBBB
      stroke_width:f32 0.4
      visible:bool true
    [Collider:circle]
      radius:f32 0.35
    [Tag]
      tags:string "ball"
    [OnCollision]
      // bounce is physics response — must fire EVERY overlapping frame, so phase
      // "stay". (The default phase is "enter", fire-once-on-contact, which is for
      // scoring/state actions like the gutter below.)
      [trigger]
        other_tag_pattern:string "wall"
        phase:string "stay"
        [action]
          type:string "bounce"
          target:string "self"
          restitution:f32 1.0
          separate:bool true
          priority:i32 0
      [trigger]
        other_tag_pattern:string "paddle"
        phase:string "stay"
        [action]
          type:string "bounce"
          target:string "self"
          restitution:f32 1.0
          separate:bool true
          priority:i32 0
      [trigger]
        other_tag_pattern:string "brick"
        phase:string "stay"
        [action]
          type:string "bounce"
          target:string "self"
          restitution:f32 1.0
          separate:bool true
          priority:i32 0

  // ── Paddle (Left/Right arrows) ──
  [Paddle:entity]
    [Transform]
      position:vec3 {0.0, -8.5, 0.0}
      scale:f32 1.0
    [Velocity]
      linear:vec2 {0.0, 0.0}
      angular:f32 0.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 2.2
      half_height:f32 0.4
      fill_color:color #66BB6A
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 2.2
      half_height:f32 0.4
    [Tag]
      tags:string "paddle"
    [OnInput]
      [trigger]
        key:string "Left"
        phase:string "held"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {-16.0, 0.0}
          priority:i32 0
      [trigger]
        key:string "Right"
        phase:string "held"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {16.0, 0.0}
          priority:i32 0
      [trigger]
        key:string "Left"
        phase:string "released"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {0.0, 0.0}
          priority:i32 0
      [trigger]
        key:string "Right"
        phase:string "released"
        [action]
          type:string "set_velocity"
          target:string "self"
          velocity:vec2 {0.0, 0.0}
          priority:i32 0

  // ── Walls (top, left, right) — invisible-ish thin colliders tagged "wall" ──
  [WallTop:entity]
    [Transform]
      position:vec3 {0.0, 9.7, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 18.0
      half_height:f32 0.3
      fill_color:color #444444
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 18.0
      half_height:f32 0.3
    [Tag]
      tags:string "wall"

  [WallLeft:entity]
    [Transform]
      position:vec3 {-17.4, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.3
      half_height:f32 10.0
      fill_color:color #444444
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.3
      half_height:f32 10.0
    [Tag]
      tags:string "wall"

  [WallRight:entity]
    [Transform]
      position:vec3 {17.4, 0.0, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.3
      half_height:f32 10.0
      fill_color:color #444444
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 0.3
      half_height:f32 10.0
    [Tag]
      tags:string "wall"

  // ── Gutter (below the paddle) — ball falling past loses a ball, re-serves ──
  [Gutter:entity]
    [Transform]
      position:vec3 {0.0, -10.6, 0.0}
      scale:f32 1.0
    [Sprite:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 18.0
      half_height:f32 0.4
      fill_color:color #2a0a0a
      visible:bool true
    [Collider:rectangle]
      center:vec2 {0.0, 0.0}
      half_width:f32 18.0
      half_height:f32 0.4
    [Tag]
      tags:string "gutter"
    // Ball fell past the paddle: lose one ball, re-serve. phase "enter" (the
    // default) fires these ONCE per ball-crossing — F1's whole point. Before
    // OnCollisionEnter this fired every overlapping frame and drained balls to
    // negative in a re-serve storm, so it had to be hand-rolled in main.zig.
    [OnCollision]
      [trigger]
        other_tag_pattern:string "ball"
        phase:string "enter"
        [action]
          type:string "add_state_int"
          key:string "balls"
          amount:i32 -1
          priority:i32 0
        [action]
          type:string "transition_state"
          name:string "serve"
          priority:i32 1

  // ── HUD: SCORE and BALLS, bound to state vars via StateText ──
  [ScoreText:entity]
    [Transform]
      position:vec3 {-16.5, 8.7, 0.0}
    [Text]
      text:string "SCORE 0"
      size:f32 1.0
      text_color:color #FFFFFF
    [StateText]
      key:string "score"
      prefix:string "SCORE "

  [LevelText:entity]
    [Transform]
      position:vec3 {-2.0, 8.7, 0.0}
    [Text]
      text:string "LEVEL 1"
      size:f32 1.0
      text_color:color #FFD54F
    [StateText]
      key:string "level"
      prefix:string "LEVEL "

  [BallsText:entity]
    [Transform]
      position:vec3 {12.5, 8.7, 0.0}
    [Text]
      text:string "BALLS 3"
      size:f32 1.0
      text_color:color #FFFFFF
    [StateText]
      key:string "balls"
      prefix:string "BALLS "
