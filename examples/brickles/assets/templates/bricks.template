// Brick templates. One ball-hit fires three actions on a single trigger:
//   destroy_self        -> brick disappears
//   add_state_int score -> +points
//   add_state_int bricks -> -1 toward the win condition (bricks == 0)
// The ball's own OnCollision handles the bounce, so bricks don't need to.
// Position is supplied by spawn offset / the scene layout that instantiates them.

[Brick:template]
  [Transform]
    position:vec2 {0.0, 0.0}
    rotation:f32 0.0
    scale:f32 1.0
  [Sprite:rectangle]
    center:vec2 {0.0, 0.0}
    half_width:f32 1.4
    half_height:f32 0.55
    fill_color:color #4FC3F7
    stroke_color:color #0288D1
    stroke_width:f32 1.0
    visible:bool true
  [Collider:rectangle]
    center:vec2 {0.0, 0.0}
    half_width:f32 1.4
    half_height:f32 0.55
  [Tag]
    tags:string "brick"
  [OnCollision]
    [trigger]
      other_tag_pattern:string "ball"
      [action]
        type:string "add_state_int"
        key:string "score"
        amount:i32 100
        priority:i32 0
      [action]
        type:string "add_state_int"
        key:string "bricks"
        amount:i32 -1
        priority:i32 1
      [action]
        type:string "destroy_self"
        priority:i32 2

